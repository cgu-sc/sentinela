SELECT
    dados.id_municipio AS id_municipio,
    diretorio_id_municipio.nome AS nome_municipio,
    diretorio_id_municipio.nome_uf AS estado,
    dados.grupo_idade AS grupo_idade,
    dados.sexo AS sexo,
    SUM(dados.populacao) AS populacao,
    dados.ano
FROM `basedosdados.br_ibge_censo_2022.populacao_grupo_idade_sexo_raca` AS dados
LEFT JOIN (
    SELECT DISTINCT id_municipio, nome, nome_uf 
    FROM `basedosdados.br_bd_diretorios_brasil.municipio`
) AS diretorio_id_municipio
    ON dados.id_municipio = diretorio_id_municipio.id_municipio
WHERE dados.ano = 2022
GROUP BY 
    dados.id_municipio, 
    diretorio_id_municipio.nome, 
    diretorio_id_municipio.nome_uf,
    dados.grupo_idade, 
    dados.ano,
    dados.sexo
ORDER BY 
    diretorio_id_municipio.nome_uf,
    diretorio_id_municipio.nome,
    dados.grupo_idade,
    dados.sexo;
	
	
	
	